# Copy to .env and adjust. All values have sensible defaults; nothing is required to run the demo offline.

# Graph backend: ladybug (embedded, default) | kuzu | networkx | neo4j
GRAPH_BACKEND=ladybug
GRAPH_DB_PATH=data/generated/graph.lbdb
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# Simulation
SIM_SEED=20260911
SIM_SCALE=1.0
SIM_NOW=2026-09-11T14:00:00Z

# Analyst agent. Without an API key the deterministic offline analyst answers every question.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
AGENT_EFFORT=high
AGENT_MODE=auto            # auto | llm | offline
AGENT_ENABLE_FALLBACKS=true

# Serving
API_HOST=127.0.0.1        # containers use 0.0.0.0; a PORT variable from the host overrides API_PORT
API_PORT=8000
LOG_LEVEL=info

# Hosted demos: set a shared password to require HTTP basic auth on every route except the health check
# DEMO_USER=team
# DEMO_PASSWORD=pick-a-strong-one
# PUBLIC_URL=https://throughline.example.com   # extra CORS origin if the UI is served from another domain
